{
  "name": "transit-map-agent",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "dev": "concurrently -k -n backend,frontend \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "cd backend && uv run fastapi dev main.py",
    "dev:frontend": "pnpm --dir frontend dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "lefthook": "2.2.2"
  },
  "packageManager": "pnpm@12.9.1"
}

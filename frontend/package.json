{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate:api": "svelte-kit sync && node scripts/generate-api.mjs",
		"predev": "pnpm generate:api",
		"prebuild": "pnpm generate:api",
		"precheck": "pnpm generate:api",
		"precheck:watch": "pnpm generate:api",
		"pretest": "pnpm generate:api",
		"test": "vitest run",
		"test:unit": "vitest",
		"pretest:unit": "pnpm generate:api"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@iconify-json/tabler": "^1.2.43",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"daisyui": "^5.7.50",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@ag-ui/client": "^1.0.4",
		"@deck.gl/core": "^9.4.1",
		"@deck.gl/geo-layers": "^9.4.1",
		"@deck.gl/layers": "^9.4.1",
		"@deck.gl/mapbox": "^9.4.1",
		"maplibre-gl": "^6.16.0",
		"zod": "^4.6.7"
	}
}
